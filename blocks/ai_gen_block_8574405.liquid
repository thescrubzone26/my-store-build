{% doc %}
  @prompt
    Modify the existing selected Image collage block to add a button below the images. Do not create a new block or remove the existing uploaded images. Keep all current images and the collage layout exactly as they are. Add one shared button displayed beneath the collage with a customizable button text/label field and a customizable link/URL field editable in the theme editor
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-collage-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-image-collage-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }

  .ai-image-collage-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.spacing }}px;
    width: 100%;
  }

  .ai-image-collage-grid-{{ ai_gen_id }}--desktop-left {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .ai-image-collage-grid-{{ ai_gen_id }}--desktop-left .ai-image-collage-item-{{ ai_gen_id }}:first-child {
    grid-row: 1 / 3;
  }

  .ai-image-collage-grid-{{ ai_gen_id }}--desktop-right {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .ai-image-collage-grid-{{ ai_gen_id }}--desktop-right .ai-image-collage-item-{{ ai_gen_id }}:last-child {
    grid-row: 1 / 3;
  }

  .ai-image-collage-grid-{{ ai_gen_id }}--mobile-collage {
    grid-template-columns: 1fr 1fr;
  }

  .ai-image-collage-grid-{{ ai_gen_id }}--mobile-collage .ai-image-collage-item-{{ ai_gen_id }}:first-child {
    grid-column: 1 / 3;
  }

  .ai-image-collage-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-image-collage-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-collage-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-collage-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-image-collage-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .ai-image-collage-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
  }

  .ai-image-collage-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    {% if block.settings.mobile_layout == 'collage' %}
      .ai-image-collage-grid-{{ ai_gen_id }} {
        grid-template-columns: 1fr 1fr;
      }

      .ai-image-collage-grid-{{ ai_gen_id }} .ai-image-collage-item-{{ ai_gen_id }}:first-child {
        grid-column: 1 / 3;
        grid-row: auto;
      }
    {% else %}
      .ai-image-collage-grid-{{ ai_gen_id }} {
        grid-template-columns: 1fr;
      }

      .ai-image-collage-grid-{{ ai_gen_id }} .ai-image-collage-item-{{ ai_gen_id }} {
        grid-column: auto;
        grid-row: auto;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-image-collage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-collage-wrapper-{{ ai_gen_id }}">
    <div class="ai-image-collage-grid-{{ ai_gen_id }} ai-image-collage-grid-{{ ai_gen_id }}--{{ block.settings.desktop_layout }} ai-image-collage-grid-{{ ai_gen_id }}--mobile-{{ block.settings.mobile_layout }}">
      {% for i in (1..3) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        
        <div class="ai-image-collage-item-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 1000 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          {% else %}
            <div class="ai-image-collage-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.button_text != blank %}
      <div class="ai-image-collage-button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.button_link }}"
          class="ai-image-collage-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image collage",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "desktop-left",
          "label": "Large image left"
        },
        {
          "value": "desktop-right",
          "label": "Large image right"
        }
      ],
      "default": "desktop-left"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "collage",
          "label": "Collage"
        },
        {
          "value": "column",
          "label": "Column"
        }
      ],
      "default": "collage"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Image spacing",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_border_thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Image collage"
    }
  ]
}
{% endschema %}
