{{ 'trust-badges.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .trust-badges-{{ section.id }} {
    --trust-badges-accent: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="trust-badges trust-badges-{{ section.id }} page-width section-{{ section.id }}-padding">
    <div class="trust-badges__grid">
      {%- for block in section.blocks -%}
        <div class="trust-badges__item" {{ block.shopify_attributes }}>
          <span class="trust-badges__icon">
            {%- render 'icon-accordion', icon: block.settings.icon -%}
          </span>
          {%- if block.settings.heading != blank -%}
            <h3 class="trust-badges__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="trust-badges__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon accent color",
      "default": "#0f2a4a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "plane", "label": "Plane" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "return", "label": "Return" },
            { "value": "star", "label": "Star" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "heart", "label": "Heart" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "stopwatch", "label": "Stopwatch" }
          ],
          "default": "check_mark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Describe this benefit."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge" },
        { "type": "badge" },
        { "type": "badge" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}
