{{ 'collection-collage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-collage-{{ section.id }} {
    --collage-gap: {{ section.settings.gap }}px;
    --collage-radius: {{ section.settings.border_radius }}px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-collage collection-collage-{{ section.id }} page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-collage__section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="collection-collage__grid">
      {%- for block in section.blocks -%}
        <div class="collection-collage__tile" {{ block.shopify_attributes }}>
          {%- case block.settings.content_type -%}
            {%- when 'heading_button' -%}
              <div class="collection-collage__split">
                <div class="collection-collage__panel" style="background-color: {{ block.settings.panel_color }}; color: {{ block.settings.text_color }};">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="collection-collage__heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  <span class="collection-collage__accent" style="background-color: {{ block.settings.accent_color }};"></span>
                  {%- if block.settings.subtext != blank -%}
                    <p class="collection-collage__subtext">{{ block.settings.subtext }}</p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                    <a
                      href="{{ block.settings.button_link }}"
                      class="collection-collage__button"
                      style="background-color: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }};"
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
                <div class="collection-collage__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 24vw, 60vw', widths: '300, 450, 600, 900, 1200'
                    }}
                  {%- else -%}
                    {{ 'model-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </div>
            {%- when 'icon_list' -%}
              <div class="collection-collage__split collection-collage__split--icons">
                <div class="collection-collage__panel" style="background-color: {{ block.settings.panel_color }}; color: {{ block.settings.text_color }};">
                  <ul class="collection-collage__icon-list">
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign icon_key = 'icon_' | append: i
                        assign label_key = 'icon_label_' | append: i
                        assign icon_value = block.settings[icon_key]
                        assign label_value = block.settings[label_key]
                      -%}
                      {%- if label_value != blank -%}
                        <li>
                          <span class="collection-collage__icon">{% render 'icon-accordion', icon: icon_value %}</span>
                          <span>{{ label_value }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
                <div class="collection-collage__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 24vw, 60vw', widths: '300, 450, 600, 900, 1200'
                    }}
                  {%- else -%}
                    {{ 'texture' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <div class="collection-collage__media collection-collage__media--full">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '375, 550, 750, 1100, 1400'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection collage",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to hide."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap between tiles",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "paragraph",
          "content": "Add exactly 4 tiles for the reference layout: tile 1 is a tall image, tile 2 is a wide banner, tiles 3-4 are two smaller banners."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "content_type",
          "label": "Tile content",
          "options": [
            { "value": "none", "label": "Image only" },
            { "value": "heading_button", "label": "Heading + button" },
            { "value": "icon_list", "label": "Icon list" }
          ],
          "default": "none"
        },
        {
          "type": "header",
          "content": "Heading + button content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Icon list content"
        },
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icon 1",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "washing", "label": "Washing" },
            { "value": "dryer", "label": "Dryer" },
            { "value": "iron", "label": "Iron" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "heart", "label": "Heart" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "star", "label": "Star" },
            { "value": "shirt", "label": "Shirt" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "icon_label_1",
          "label": "Icon 1 label"
        },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icon 2",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "washing", "label": "Washing" },
            { "value": "dryer", "label": "Dryer" },
            { "value": "iron", "label": "Iron" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "heart", "label": "Heart" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "star", "label": "Star" },
            { "value": "shirt", "label": "Shirt" }
          ],
          "default": "recycle"
        },
        {
          "type": "text",
          "id": "icon_label_2",
          "label": "Icon 2 label"
        },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icon 3",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "washing", "label": "Washing" },
            { "value": "dryer", "label": "Dryer" },
            { "value": "iron", "label": "Iron" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "heart", "label": "Heart" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "star", "label": "Star" },
            { "value": "shirt", "label": "Shirt" }
          ],
          "default": "washing"
        },
        {
          "type": "text",
          "id": "icon_label_3",
          "label": "Icon 3 label"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "panel_color",
          "label": "Panel background",
          "default": "#eef4fa"
        },
        {
          "type": "color",
          "id": "text_color",
