{{ 'faq-help.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .faq-help-{{ section.id }} {
    --faq-help-accent: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="faq-help faq-help-{{ section.id }} page-width section-{{ section.id }}-padding">
    <div class="faq-help__grid">
      <div class="faq-help__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.caption != blank -%}
          <p class="faq-help__caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="faq-help__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="faq-help__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="faq-help__accordion">
          {%- for block in section.blocks -%}
            <details class="faq-help__row" {{ block.shopify_attributes }}>
              <summary class="faq-help__summary" id="FaqSummary-{{ block.id }}">
                <span class="faq-help__icon-badge">
                  {%- render 'icon-accordion', icon: block.settings.icon -%}
                </span>
                <span class="faq-help__question">{{ block.settings.question | escape }}</span>
                <span class="faq-help__chevron">{{ 'icon-caret.svg' | inline_asset_content }}</span>
              </summary>
              <div class="faq-help__answer rte" role="region" aria-labelledby="FaqSummary-{{ block.id }}">
                {{ block.settings.answer }}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>

      <div class="faq-help__media global-media-settings gradient">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 45vw, 100vw',
              widths: '375, 550, 750, 1100, 1500'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg faq-help__placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ - Need help",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "FAQS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Need Help?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Answers to our most common questions, so you can shop with confidence."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0f2a4a"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "heart", "label": "Heart" },
            { "value": "lock", "label": "Lock" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "question_mark", "label": "Question mark" },
            { "value": "return", "label": "Return" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "star", "label": "Star" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "question_mark"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Share details about this question.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ - Need help",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
