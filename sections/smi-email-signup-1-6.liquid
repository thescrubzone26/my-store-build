        <p class="smi-field-validate smi-mt-xs smi-text-sm smi-color-text-75">
          <span class="smi-icon-sucess">{{icon_success}}</span>
          <span>{{form_success}}</span>
        </p>
      </div>
    {%- elsif form.errors -%}
      <div class="smi-form-message smi-form-error">
        <p class="smi-field-validate smi-mt-xs smi-text-sm smi-color-text-75">
        </p>
      </div>
    {%- else -%}
