    value="{{ form.email }}"
    aria-required="true"
    autocorrect="off"
    autocapitalize="off"
    autocomplete="off"
    placeholder="{% if isPasswordSub and isPasswordSub == true %}{{placeholder_email_password}}{%else%}{{placeholder_email}}{% endif %}"
