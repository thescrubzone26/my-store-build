{{ 'about-closing.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="about-closing color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.body != blank -%}
      <div class="about-closing__body rte">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}
      <p class="about-closing__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}
    {%- if section.settings.signoff != blank -%}
      <p class="about-closing__signoff">{{ section.settings.signoff }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About closing",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline"
    },
    {
      "type": "text",
      "id": "signoff",
      "label": "Sign-off line"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-footer-premium"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "About closing"
    }
  ]
}
{% endschema %}
