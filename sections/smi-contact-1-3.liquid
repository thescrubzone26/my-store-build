{% schema %}
{
	"name": "✧Contact 1-3",
	"tag": "section",
	"class": "smi-section smi-basdico-iftem smi-contact-1",
	"disabled_on": {
		"groups": [
			"header",
			"footer",
			"aside"
		]
	},
	"settings": [
		{
			"type": "select",
			"id": "display_on",
			"label": "Display on",
			"options": [
				{
					"value": "desktop",
					"label": "Desktop only"
				},
				{
					"value": "mobile",
					"label": "Mobile only"
				},
				{
					"value": "all",
					"label": "All device"
				}
			],
			"default": "all"
		},
		{
			"type": "checkbox",
			"id": "container_full_width",
			"label": "Container full-width",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "custom_width",
			"label": "Custom width",
			"default": false,
			"visible_if": "{{ section.settings.container_full_width == false }}"
		},
		{
			"type": "range",
			"id": "section_width",
			"label": "Section width",
			"min": 800,
			"max": 2000,
			"step": 20,
			"unit": "px",
			"default": 1200,
			"visible_if": "{{ section.settings.container_full_width == false and section.settings.custom_width == true }}"
		},
		{
			"type": "paragraph",
			"content": "Advanced font controls are available in Smind Style. [Learn more](https://docs.smind.io/guides/configuring-typography)"
