          required
          messageRequired = "{{messageRequired}}"
          {% endif %}
        ></textarea>
    </div>
</div>
{% else %}
    {% liquid
	assign messageRequired = contact_name | append:" can't be blank" 
%}
<div
    class="smi-field smi-block-{{forloop.index}} smi-mb-sm" {{ block.shopify_attributes }}
    >
    <label for="smi-field-{{forloop.index}}">
		{{ contact_name }}
		{%- if block.settings.required != blank %}*{% endif %}
    </label>
    <div class="smi-outline-focus smi-inputs-wrapper smi-border smi-border smi-shadow">
      <input class="smi-input-field"
        name="contact[{{ contact_name }}]"
        value="{{field_val}}"
        type="text" 
        {%- if block.settings.required != blank %} 
			required
        messageRequired = "{{messageRequired}}"
        {% endif %}
        id="smi-field-{{forloop.index}}"
      >
    </div>
</div>
{% endif %}
                            {% endif %}
                            {% if block.type == 'dropdown_option' %}
                                <div
  class="smi-field smi-block-select smi-block-{{ block.id }} smi-mb-sm"
  {{ block.shopify_attributes }}
>
  <label for="smi-field-{{forloop.index}}">
      {{ contact_name }}
  </label>
  {% assign arrayOfContent = block.settings.options | newline_to_br | strip_newlines | split: ', ' %}
  <div class="smi-field-select  smi-dropdown-wrapper smi-p-relative">
    <button type="button" class="smi-dropdown__button smi-dropdown smi-inputs-wrapper smi-outline-focus  smi-border smi-shadow smi-d-flex smi-column-gap-xxs smi-p-0 bg-transparent smi-cursor-pointer">
