              <a href="#" data-value="{{ item }}" class="smi-color-text">
                {{ item }}
              </a>
          </li>
      {%- endfor -%}
    </ul>
    <input class="smi-selector" type="hidden" name="contact[{{contact_name}}]" value="{{ arrayOfContent[0] }}">
  </div>
</div>
                            {% endif %}
                        {% endfor %}
                        {% liquid
    assign labelMessage = 'smind.form.label_message' | t
%}
<div
