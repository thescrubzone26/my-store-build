{% comment %}
  Renders the "Add Embroidery" trigger, its staged-summary card, and the personalization modal.

  The modal only stages a customization (name/designation/icon/upload/etc). Nothing is added to
  the cart until the customer clicks the product's real "Add to cart" button - the staged values
  are attached to that submission via inputs associated to product_form_id through the `form`
  attribute, and the matching priced personalization product/variant is added as a second cart
  line right after, once the main add succeeds.

  Accepts:
  - block: {Object} the embroidery block
  - product: {Object} the current product
  - section: {Object} the current section
  - product_form_id: {String} id of the main add-to-cart form
  - name_product: {Object} product charged for name embroidery (or blank)
  - name_available: {Boolean} whether name_product has a purchasable variant
  - name_variant: {Object} name_product's selected_or_first_available_variant
  - icon_product: {Object} product whose variants make up the icon catalog (or blank)
  - icon_variants: {Array} icon_product's available variants
  - icon_available: {Boolean} whether icon_variants has at least one entry

  Usage:
  {% render 'embroidery-modal', block: block, product: product, section: section, product_form_id: product_form_id, ... %}
{% endcomment %}

{%- liquid
  assign embroidery_default_tab = 'name'
  unless name_available
    assign embroidery_default_tab = 'icon'
  endunless

  assign embroidery_colors = block.settings.color_1 | append: '|' | append: block.settings.color_2 | append: '|' | append: block.settings.color_3 | append: '|' | append: block.settings.color_4 | append: '|' | append: block.settings.color_5
  assign embroidery_colors = embroidery_colors | split: '|'

  assign embroidery_color_names = block.settings.color_1_name | append: '|' | append: block.settings.color_2_name | append: '|' | append: block.settings.color_3_name | append: '|' | append: block.settings.color_4_name | append: '|' | append: block.settings.color_5_name
  assign embroidery_color_names = embroidery_color_names | split: '|'

  if icon_available
    assign embroidery_icon_prices = icon_variants | map: 'price' | sort
    assign embroidery_icon_min_price = embroidery_icon_prices | first
    assign embroidery_icon_max_price = embroidery_icon_prices | last
  endif
-%}

<div class="embroidery-wrap" data-embroidery-section="{{ section.id }}">
  <modal-opener data-modal="#Embroidery-Modal-{{ section.id }}">
    <button type="button" class="embroidery-trigger" data-embroidery-trigger-button {{ block.shopify_attributes }}>
      <span class="embroidery-trigger__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M7.5 13.2c1-2.1 2.6-3.2 4.5-3.2s3.5 1.1 4.5 3.2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
          <path d="M9.3 9.3c.8-.6 1.7-1 2.7-1s1.9.4 2.7 1" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="embroidery-trigger__label">{{ block.settings.button_label }}</span>
    </button>
  </modal-opener>

  <div class="embroidery-summary" data-embroidery-summary hidden>
    <div class="embroidery-summary__header">
      <span class="embroidery-summary__label">{{ block.settings.summary_label }}</span>
      <span class="embroidery-summary__price" data-embroidery-summary-price></span>
      <button type="button" class="embroidery-summary__edit" data-embroidery-edit>
        {{ 'products.product.embroidery.edit' | t }}
      </button>
      <button
        type="button"
        class="embroidery-summary__delete"
        data-embroidery-delete
        aria-label="{{ 'products.product.embroidery.remove' | t }}"
      >
        {{ 'icon-remove.svg' | inline_asset_content }}
      </button>
    </div>
    <div class="embroidery-summary__body">
      <div
        class="embroidery-summary__preview"
        data-embroidery-summary-preview
        style="--embroidery-preview-bg: {{ block.settings.preview_background_color }};"
      >
        <span data-embroidery-summary-preview-text></span>
      </div>
      <dl class="embroidery-summary__details" data-embroidery-summary-details></dl>
    </div>
  </div>

  <p class="embroidery-wrap__error" data-embroidery-wrap-error hidden></p>
</div>

<modal-dialog id="Embroidery-Modal-{{ section.id }}" class="embroidery-modal">
  <div
    class="embroidery-modal__dialog color-{{ section.settings.color_scheme }} gradient"
    role="dialog"
    aria-label="{{ block.settings.modal_heading }}"
    aria-modal="true"
    tabindex="-1"
  >
    <embroidery-personalizer
      class="embroidery-personalizer"
      data-product-form-id="{{ product_form_id }}"
      data-section-id="{{ section.id }}"
      data-product-title="{{ product.title | escape }}"
      data-active-tab="{{ embroidery_default_tab }}"
      data-type-name-label="{{ 'products.product.embroidery.type_name' | t }}"
      data-type-icon-label="{{ 'products.product.embroidery.type_icon' | t }}"
      data-type-both-label="{{ 'products.product.embroidery.type_both' | t }}"
      {% if name_available %}
        data-name-variant-id="{{ name_variant.id }}"
        data-name-price-formatted="{{ name_variant.price | money }}"
        data-name-placement="{{ block.settings.name_placement_label | escape }}"
      {% endif %}
      {% if icon_available %}
        data-icon-range-formatted="{{ embroidery_icon_min_price | money }}{% if embroidery_icon_min_price != embroidery_icon_max_price %} - {{ embroidery_icon_max_price | money }}{% endif %}"
        data-icon-placement="{{ block.settings.icon_placement_label | escape }}"
      {% endif %}
    >
      <div class="embroidery-modal__header">
        <h2 class="embroidery-modal__heading">{{ block.settings.modal_heading }}</h2>
        <button
          id="ModalClose-{{ section.id }}"
          type="button"
          class="embroidery-modal__close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="embroidery-modal__tabs" role="tablist">
        {%- if name_available -%}
          <button
            type="button"
            class="embroidery-modal__tab{% if embroidery_default_tab == 'name' %} embroidery-modal__tab--active{% endif %}"
            role="tab"
            data-embroidery-tab="name"
            aria-selected="{% if embroidery_default_tab == 'name' %}true{% else %}false{% endif %}"
          >
            {{ block.settings.tab_name_label }}
          </button>
        {%- endif -%}
        {%- if icon_available -%}
          <button
            type="button"
            class="embroidery-modal__tab{% if embroidery_default_tab == 'icon' %} embroidery-modal__tab--active{% endif %}"
            role="tab"
            data-embroidery-tab="icon"
            aria-selected="{% if embroidery_default_tab == 'icon' %}true{% else %}false{% endif %}"
          >
            {{ block.settings.tab_icon_label }}
          </button>
        {%- endif -%}
        {%- if name_available and icon_available -%}
          <button
            type="button"
            class="embroidery-modal__tab"
            role="tab"
            data-embroidery-tab="both"
            aria-selected="false"
          >
            {{ block.settings.tab_both_label }}
          </button>
        {%- endif -%}
      </div>

      <p class="embroidery-modal__price" data-embroidery-price>
        {%- if embroidery_default_tab == 'name' and name_available -%}
          {{- name_variant.price | money -}}
        {%- elsif icon_available -%}
          {%- if embroidery_icon_min_price == embroidery_icon_max_price -%}
            {{- embroidery_icon_min_price | money -}}
          {%- else -%}
            {{- embroidery_icon_min_price | money }} - {{ embroidery_icon_max_price | money -}}
          {%- endif -%}
        {%- endif -%}
      </p>

      <div class="embroidery-modal__body">
        {%- if name_available -%}
          <div class="embroidery-field-group" data-embroidery-group="name" {% if embroidery_default_tab != 'name' %}hidden{% endif %}>
            <p class="embroidery-field-group__placement">
              {{ 'products.product.embroidery.name_placement' | t }}
              <strong>{{ block.settings.name_placement_label }}</strong>
            </p>

            <label class="form__label" for="EmbroideryName-{{ section.id }}">
              {{ 'products.product.embroidery.name' | t }}
            </label>
            <input
              type="text"
              id="EmbroideryName-{{ section.id }}"
              name="properties[Name]"
              form="{{ product_form_id }}"
              class="embroidery-input"
              data-embroidery-name
              maxlength="20"
              placeholder="{{ 'products.product.embroidery.name_placeholder' | t }}"
              disabled
            >

            <label class="form__label" for="EmbroideryDesignation-{{ section.id }}">
              {{ 'products.product.embroidery.designation' | t }}
            </label>
            <input
              type="text"
              id="EmbroideryDesignation-{{ section.id }}"
              name="properties[Designation]"
              form="{{ product_form_id }}"
              class="embroidery-input"
              data-embroidery-designation
              maxlength="30"
              placeholder="{{ 'products.product.embroidery.designation_placeholder' | t }}"
              disabled
            >

            <input
              type="hidden"
              name="properties[Name Placement]"
              form="{{ product_form_id }}"
              value="{{ block.settings.name_placement_label }}"
              data-embroidery-name-placement-input
              disabled
            >
            <input
              type="hidden"
              name="properties[Font Color]"
              form="{{ product_form_id }}"
              data-embroidery-color-input
              disabled
            >
            <input
              type="hidden"
              name="properties[Font]"
              form="{{ product_form_id }}"
              data-embroidery-font-input
              disabled
            >

            <p class="embroidery-field-group__label">{{ 'products.product.embroidery.font_color' | t }}</p>
            <div class="embroidery-swatches" role="radiogroup" aria-label="{{ 'products.product.embroidery.font_color' | t }}">
              {%- for color in embroidery_colors -%}
                <button
                  type="button"
                  class="embroidery-swatch"
                  style="--embroidery-swatch-color: {{ color }};"
                  data-embroidery-color="{{ color }}"
                  data-embroidery-color-name="{{ embroidery_color_names[forloop.index0] | escape }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="{{ embroidery_color_names[forloop.index0] | escape }}"
                ></button>
              {%- endfor -%}
            </div>

            <p class="embroidery-field-group__label">
              {{ 'products.product.embroidery.font' | t }}
              <strong data-embroidery-font-label>{{ 'products.product.embroidery.font_block' | t }}</strong>
            </p>
            <div class="embroidery-font-options">
              <button
                type="button"
                class="embroidery-font-option"
                data-embroidery-font="{{ 'products.product.embroidery.font_block' | t }}"
                data-embroidery-font-style="block"
                aria-pressed="true"
              >
                {{ 'products.product.embroidery.font_block' | t }}
              </button>
              <button
                type="button"
                class="embroidery-font-option embroidery-font-option--script"
                data-embroidery-font="{{ 'products.product.embroidery.font_script' | t }}"
                data-embroidery-font-style="script"
                aria-pressed="false"
              >
                {{ 'products.product.embroidery.font_script' | t }}
              </button>
            </div>
          </div>
        {%- endif -%}

        {%- if icon_available -%}
          <div class="embroidery-field-group" data-embroidery-group="icon" {% if embroidery_default_tab != 'icon' %}hidden{% endif %}>
            <p class="embroidery-field-group__placement">
              {{ 'products.product.embroidery.icon_placement' | t }}
              <strong>{{ block.settings.icon_placement_label }}</strong>
            </p>

            <input
              type="hidden"
              name="properties[Icon Placement]"
              form="{{ product_form_id }}"
              value="{{ block.settings.icon_placement_label }}"
              data-embroidery-icon-placement-input
              disabled
            >
            <input
              type="hidden"
              name="properties[Icon]"
              form="{{ product_form_id }}"
              data-embroidery-icon-input
              disabled
            >

            <p class="embroidery-field-group__label">
              {{ 'products.product.embroidery.icon' | t }}
              <strong data-embroidery-icon-label>{{ 'products.product.embroidery.icon_none_selected' | t }}</strong>
            </p>
            <div class="embroidery-icon-grid" role="radiogroup" aria-label="{{ 'products.product.embroidery.icon' | t }}">
              {%- for variant in icon_variants -%}
                <button
                  type="button"
                  class="embroidery-icon"
                  data-embroidery-icon-id="{{ variant.id }}"
                  data-embroidery-icon-label="{{ variant.title | escape }}"
                  data-embroidery-icon-price-formatted="{{ variant.price | money }}"
                  {% if name_available %}
                    data-embroidery-icon-both-price-formatted="{{ variant.price | plus: name_variant.price | money }}"
                  {% endif %}
                  aria-pressed="false"
                  aria-label="{{ variant.title | escape }}"
                >
                  {%- if variant.featured_image -%}
                    {{ variant.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '40px' }}
                  {%- else -%}
                    <span class="embroidery-icon__placeholder">{{ variant.title | slice: 0, 1 }}</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>

            {%- if block.settings.enable_custom_icon_upload -%}
              <div class="embroidery-upload">
                <label class="embroidery-upload__button" for="EmbroideryUpload-{{ section.id }}">
                  <span class="svg-wrapper" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 16V4M12 4L7 9M12 4l5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  {{ 'products.product.embroidery.upload_custom_icon' | t }}
                </label>
                <input
                  type="file"
                  id="EmbroideryUpload-{{ section.id }}"
                  name="properties[Custom Icon]"
                  form="{{ product_form_id }}"
                  class="visually-hidden"
                  accept="image/*"
                  data-embroidery-custom-icon-input
                  disabled
                >
                <p class="embroidery-upload__hint">{{ block.settings.upload_max_size_text }}</p>
                <p class="embroidery-upload__filename" data-embroidery-custom-icon-filename hidden></p>
              </div>

              <label class="form__label" for="EmbroiderySpecialRequest-{{ section.id }}">
                {{ 'products.product.embroidery.special_requests' | t }}
              </label>
              <textarea
                id="EmbroiderySpecialRequest-{{ section.id }}"
                name="properties[Special Requests]"
                form="{{ product_form_id }}"
                class="embroidery-textarea"
                data-embroidery-special-request
                rows="3"
                placeholder="{{ 'products.product.embroidery.special_requests_placeholder' | t }}"
                disabled
              ></textarea>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if block.settings.disclaimer != blank -%}
        <div class="embroidery-modal__disclaimer rte">{{ block.settings.disclaimer }}</div>
      {%- endif -%}

      <p class="embroidery-modal__error" data-embroidery-error hidden></p>

      <div class="embroidery-modal__actions">
        <button type="button" class="button button--secondary" data-embroidery-reset>
          {{ 'products.product.embroidery.reset' | t }}
        </button>
        <button type="button" class="button button--primary" data-embroidery-submit>
          <span data-embroidery-submit-label>{{ 'products.product.embroidery.add' | t }}</span>
          {%- render 'loading-spinner' -%}
        </button>
      </div>
    </embroidery-personalizer>
  </div>
</modal-dialog>
