    "faq_help_1": {
      "type": "faq-help",
      "blocks": {
        "question_services": {
          "type": "question",
          "settings": {
            "icon": "shirt",
            "question": "What services does The Scrub Zone offer?",
            "answer": "<p>We offer a wide range of high-quality medical and healthcare products, including surgical scrubs, medical uniforms, lab coats, and other professional healthcare essentials — plus embroidery personalization on select styles.</p>"
          }
        },
        "question_size": {
          "type": "question",
          "settings": {
            "icon": "ruler",
            "question": "How do I choose the right size?",
            "answer": "<p>You can refer to our size guide available on every product page. If you're unsure about your size, our team is happy to help you find the right fit.</p>"
          }
        },
        "question_personalize": {
          "type": "question",
          "settings": {
            "icon": "star",
            "question": "Can I personalize my scrubs?",
            "answer": "<p>Yes! Select styles let you add your name, an image, or both via embroidery. Just choose \"Add Embroidery\" on the product page and customize before adding to cart.</p>"
          }
        },
        "question_returns": {
          "type": "question",
          "settings": {
            "icon": "return",
            "question": "What is your return & exchange policy?",
            "answer": "<p>Unworn, unwashed items in original condition can be returned or exchanged within 30 days of delivery. Embroidered and personalized items are final sale.</p>"
          }
        },
        "question_tracking": {
          "type": "question",
          "settings": {
            "icon": "truck",
            "question": "How can I track my order?",
            "answer": "<p>Once your order ships, you'll receive a confirmation email with a tracking link so you can follow your package every step of the way.</p>"
          }
        }
      },
      "block_order": [
        "question_services",
